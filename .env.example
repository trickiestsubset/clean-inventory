# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The name of the public storage bucket used for part photos (created by supabase/schema.sql instructions)
SUPABASE_PHOTO_BUCKET=part-photos

# The shared passcode everyone types in to unlock the app
APP_PASSCODE=change-me

# A long random string used to sign the login cookie so it can't be forged.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too
